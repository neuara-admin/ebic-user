<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system CAs only. User-installed CAs are NOT trusted,
     so a certificate added to the device cannot intercept API, payment or
     health traffic. The debug variant (src/debug/res/xml) relaxes this for
     local development. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
